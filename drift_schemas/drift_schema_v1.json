      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"user_profiles\" (\"id\" INTEGER NOT NULL, \"name\" TEXT NULL, \"height_cm\" REAL NULL, \"weight_unit\" TEXT NOT NULL, \"length_unit\" TEXT NOT NULL, \"rest_timer_seconds\" INTEGER NOT NULL DEFAULT 90, \"weekly_workout_goal\" INTEGER NOT NULL DEFAULT 3, \"weekly_minutes_goal\" INTEGER NOT NULL DEFAULT 180, \"weekly_sets_goal\" INTEGER NOT NULL DEFAULT 45, \"created_at\" INTEGER NOT NULL DEFAULT (CAST(strftime('%s', CURRENT_TIMESTAMP) AS INTEGER)), \"updated_at\" INTEGER NOT NULL DEFAULT (CAST(strftime('%s', CURRENT_TIMESTAMP) AS INTEGER)), PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "exercises",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"exercises\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"name\" TEXT NOT NULL, \"primary_muscle\" TEXT NOT NULL, \"secondary_muscles\" TEXT NOT NULL DEFAULT '', \"equipment\" TEXT NOT NULL, \"tracking_type\" TEXT NOT NULL, \"description\" TEXT NULL, \"is_custom\" INTEGER NOT NULL DEFAULT 0 CHECK (\"is_custom\" IN (0, 1)), \"archived_at\" INTEGER NULL, \"created_at\" INTEGER NOT NULL DEFAULT (CAST(strftime('%s', CURRENT_TIMESTAMP) AS INTEGER)), \"updated_at\" INTEGER NOT NULL DEFAULT (CAST(strftime('%s', CURRENT_TIMESTAMP) AS INTEGER)));"
        }
      ]
    },
